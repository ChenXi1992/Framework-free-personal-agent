# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed.

# DeepSeek API key (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=sk-replace-me

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:replace-me

# Your Telegram numeric user ID(s), comma-separated. Get yours from @userinfobot.
# Only these users will get answers from the bot.
TELEGRAM_ALLOWED_USER_IDS=123456789

# Where to keep the SQLite database. This default works for local dev
# (creates ./data/me.db relative to the project root).
# In Docker, compose.yml overrides this to /data/me.db (the mounted volume).
DB_PATH=./data/me.db

# Python logging level. Set to DEBUG to show every tool invocation as a
# header line on each Telegram reply (useful for catching hallucinated
# tool calls). INFO is fine for daily use.
LOG_LEVEL=INFO

# LLM behaviour
# Base URL — swap to https://api.openai.com/v1 (+ change API key) to use OpenAI
# or point at a local Ollama endpoint for fully offline use.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Main agent creativity: 0.0 = fully deterministic, 1.0 = most varied.
# Lower this (e.g. 0.5) for more focused/conservative answers.
AGENT_TEMPERATURE=0.9
# Hard cap on tool-call iterations per message. Raise for deep research tasks,
# lower to cut costs. Each iteration = 1 LLM call + its tool calls.
MAX_TOOL_TURNS=10

# Conversation history turns included per agent call (raw messages).
# HISTORY_TURNS=20

# Conversation summarisation: when an agent's total turns exceed this threshold,
# the oldest turns (beyond the recent 20) are summarised into a paragraph and
# injected as persistent memory. Summarisation fires once per threshold crossing.
# Lower this (e.g. 4) to test the feature quickly.
# CONVERSATION_SUMMARY_THRESHOLD=40

# Append-only JSONL audit log of every user message, LLM call, tool call,
# /confirm, and /cancel. Useful for debugging "what did the bot actually do?"
# Default: ./data/agent.log.json. Set to '' to disable.
AUDIT_LOG_PATH=./data/agent.log.json

# --- Web search (optional) ------------------------------------------------
# Tavily API key for the web_search tool (https://app.tavily.com).
# Free tier: 1,000 searches/month. Leave blank to disable.
TAVILY_API_KEY=

# --- Notion integration (optional) ----------------------------------------
# Create internal integrations at https://www.notion.so/profile/integrations
# Then in Notion, share each page/database with the integration via
# the page's "..." menu -> "Connect to". Pages that aren't shared are
# invisible to the integration even if you own them.
# Leave a token blank to disable that workspace.
# Option A — Internal integration token (requires workspace admin):
NOTION_TOKEN_PERSONAL=
NOTION_TOKEN_WORK=
# Option B — OAuth app (no admin rights needed). Run `python -m app.tools.notion_auth`
# after setting these two values. Token is saved to data/notion_token_personal.json.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# --- Gmail integration (optional) -----------------------------------------
# No env var here — Gmail uses OAuth via two files in ./data/:
#   gmail_credentials.json   (download from Google Cloud Console)
#   gmail_token.json         (auto-generated by `python -m app.tools.gmail_auth`)
# See README §7 for the one-time setup.

# --- Slack integration (optional) -----------------------------------------
# Create a Slack app at https://api.slack.com/apps, configure User Token
# scopes (channels/groups/im/mpim history+read, users:read, search:read,
# chat:write), install to your workspace, copy the User OAuth Token (xoxp-).
# Leave a token blank to disable that workspace.
SLACK_TOKEN_PERSONAL=
SLACK_TOKEN_WORK=

# --- Local file tools (optional) ------------------------------------------
# Root directory the agent is allowed to read/write.
# Defaults to ./data (the project's own data directory) so every agent reads
# and writes to the same place and nothing leaks onto the host filesystem.
# Override only if you want the agent to access a different directory.
# FILES_ROOT=./data

# --- Agent behaviour (optional) -------------------------------------------
# Which specialist agent handles diary entries when the router returns agent=none.
# Change this if you rename or replace the growth agent.
# DIARY_DEFAULT_AGENT=growth

# Timezone for weekly summary generation (Monday 00:00 boundary).
# Any IANA timezone name: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Europe/Amsterdam
